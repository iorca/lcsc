# LCSC Docker 部署环境变量
# 复制为 .env 后修改密码；.env 已被 .gitignore 排除，不要提交。

# 对外访问端口（容器内 Nginx 监听 80）
LCSC_PORT=8080

# 宿主绑定地址：0.0.0.0=直接暴露；127.0.0.1=仅本机（配合宿主反向代理，推荐）
LCSC_BIND_IP=0.0.0.0

# MySQL root 密码（应用在容器内网以 root 连接；请改为长随机串）
MYSQL_ROOT_PASSWORD=change-me-root

# 数据库名（MySQL 首次初始化时创建）
LCSC_DB_NAME=lcsc

# 首次启动是否免向导自动安装：1=自动；0=改为浏览器访问 /install.php
LCSC_AUTOINSTALL=1

# 版本：personal（个人版）/ studio（团队版），安装后锁定
LCSC_EDITION=studio

# 自动安装时创建的管理员（密码至少 8 位且包含大写/小写/数字/特殊字符中的 3 类）
# 下面的占位密码满足强度要求，但上线前必须改成你自己的密码
LCSC_ADMIN_USER=admin
LCSC_ADMIN_PASS=ChangeMe-Admin123

# 时区
LCSC_TZ=Asia/Shanghai

# 登录密码开关：true=进入需账号密码（默认）；false=免登录，自动以主管理员身份直接进入（纯本机单人可用）
# 优先级高于后台「系统设置 → 登录密码」开关
# LCSC_LOGIN_ENABLED=true

# ── 国内网络加速（默认全部走官方源；网络慢时按需取消注释）──
# 1) 基础镜像：换成你实测可用的镜像代理地址（示例为 DaoCloud 公共代理，失效时请换其他）
# PHP_IMAGE=docker.m.daocloud.io/library/php:8.3-fpm-alpine
# COMPOSER_IMAGE=docker.m.daocloud.io/library/composer:2
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
#
# 2) Alpine apk 包镜像（只填主机名，不要带 https://）
# APK_MIRROR=mirrors.aliyun.com
#
# 3) Composer / Packagist 镜像（完整 URL，结尾带 /）
# COMPOSER_MIRROR=https://mirrors.aliyun.com/composer/
